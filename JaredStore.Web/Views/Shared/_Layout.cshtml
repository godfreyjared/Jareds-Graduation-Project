
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Continental Computing Solutions</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/JaredStore.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="continental-body">

    <header class="continental-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">

                <a class="navbar-brand continental-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/continental-logo.png"
                         alt="Continental Computing Solutions"
                         class="continental-logo" />

                    <span class="brand-text">
                        <strong>CONTINENTAL</strong>
                        <small>COMPUTING SOLUTIONS</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#continentalNavbar"
                        aria-controls="continentalNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="continentalNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Index">
                                Products
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Inventory"
                               asp-action="Index">
                                Inventory
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link continental-cart-link"
                               asp-controller="Cart"
                               asp-action="Index">
                                Cart
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container continental-content">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="continental-footer">
        <div class="container">

            <div class="footer-content">
                <div>
                    <strong>CONTINENTAL</strong>
                    <span>COMPUTING SOLUTIONS</span>
                </div>

                <p>
                    &copy; 2026 Continental Computing Solutions.
                    All rights reserved.
                </p>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
