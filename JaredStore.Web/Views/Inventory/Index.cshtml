@model List<Jared_s_Graduation_Project.Inventory>
@using Jared_s_Graduation_Project

@{
    ViewData["Title"] = "Inventory";

    var products = (List<Product>)ViewBag.Products;

    int? selectedStoreID = ViewBag.StoreID == null
        ? null
        : (int)ViewBag.StoreID;

    string storeName = selectedStoreID switch
    {
        1 => "Houston",
        2 => "Dallas",
        3 => "San Antonio",
        _ => "Select a Location"
    };
}

<section class="ccs-inventory-page">

    <div class="ccs-page-heading">
        <span class="ccs-eyebrow">CONTINENTAL OPERATIONS</span>
        <h1>Store Inventory</h1>
        <p>
            Monitor live stock, transfer inventory between locations,
            and manage employee reservations.
        </p>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="ccs-notice @(TempData["MessageType"]?.ToString() == "error" ? "ccs-notice-error" : "")"
             role="status">
            @TempData["Message"]
        </div>
    }

    <section class="ccs-dashboard-section">

        <div class="ccs-section-heading">
            <h2>Select a Location</h2>
            <p>Choose a store to view its current inventory.</p>
        </div>

        <div class="ccs-store-grid">

            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-storeID="1"
               class="ccs-store-card @(selectedStoreID == 1 ? "is-active" : "")"
               aria-current="@(selectedStoreID == 1 ? "page" : null)">

                <span class="ccs-store-icon">01</span>
                <span class="ccs-store-name">Houston</span>
                <span class="ccs-store-caption">Texas Location</span>
                <span class="ccs-store-action">View Inventory &rarr;</span>
            </a>

            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-storeID="2"
               class="ccs-store-card @(selectedStoreID == 2 ? "is-active" : "")"
               aria-current="@(selectedStoreID == 2 ? "page" : null)">

                <span class="ccs-store-icon">02</span>
                <span class="ccs-store-name">Dallas</span>
                <span class="ccs-store-caption">Texas Location</span>
                <span class="ccs-store-action">View Inventory &rarr;</span>
            </a>

            <a asp-controller="Inventory"
               asp-action="Index"
               asp-route-storeID="3"
               class="ccs-store-card @(selectedStoreID == 3 ? "is-active" : "")"
               aria-current="@(selectedStoreID == 3 ? "page" : null)">

                <span class="ccs-store-icon">03</span>
                <span class="ccs-store-name">San Antonio</span>
                <span class="ccs-store-caption">Texas Location</span>
                <span class="ccs-store-action">View Inventory &rarr;</span>
            </a>

        </div>

    </section>

    @if (selectedStoreID != null)
    {
        <section class="ccs-dashboard-section ccs-inventory-panel">

            <div class="ccs-section-heading">
                <span class="ccs-eyebrow">LIVE STOCK MONITOR</span>
                <h2>@storeName Inventory</h2>
                <p>
                    Available and reserved quantities
                    refresh automatically every 10 seconds.
                </p>
            </div>

            <div class="ccs-table-wrapper">

                <table class="ccs-inventory-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Unit Price</th>
                            <th>Available</th>
                            <th>Total Reserved</th>
                            <th>Employee Reserved</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var product = products.FirstOrDefault(p =>
                            p.ProductID == item.ProductID);

                            if (product != null)
                            {
                                <tr>

                                    <td class="ccs-product-name">
                                        @product.ProductName
                                    </td>

                                    <td>@product.ProductCategory</td>

                                    <td>
                                        @product.ProductPrice.ToString("C")
                                    </td>

                                    <td>
                                        <span class="ccs-stock-badge @(item.Quantity <= 0 ? "is-out-of-stock" : "")"
                                              id="stock-badge-@item.ProductID">

                                            <span id="quantity-@item.ProductID">
                                                @item.Quantity
                                            </span>
                                        </span>
                                    </td>

                                    <td>
                                        <span id="reserved-@item.ProductID">
                                            @item.ReservedQuantity
                                        </span>
                                    </td>

                                    <td>
                                        <span id="employee-reserved-@item.ProductID">
                                            @item.EmployeeReservedQuantity
                                        </span>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </section>
    }

    <section class="ccs-dashboard-section ccs-transfer-panel">

        <div class="ccs-section-heading">
            <span class="ccs-eyebrow">EMPLOYEE INVENTORY CONTROL</span>
            <h2>Adjust Available Stock</h2>
            <p>Add new units or remove available units without changing customer or employee reservations.</p>
        </div>

        <form asp-controller="Inventory" asp-action="AdjustStock" method="post">
            @Html.AntiForgeryToken()

            <div class="ccs-form-grid">
                <div class="ccs-field">
                    <label for="adjustStoreID">Store</label>
                    <select id="adjustStoreID" name="storeID" class="form-select" required>
                        <option value="1" selected="@(selectedStoreID == 1)">Houston</option>
                        <option value="2" selected="@(selectedStoreID == 2)">Dallas</option>
                        <option value="3" selected="@(selectedStoreID == 3)">San Antonio</option>
                    </select>
                </div>

                <div class="ccs-field">
                    <label for="adjustProductID">Product</label>
                    <select id="adjustProductID" name="productID" class="form-select" required>
                        @foreach (var product in products)
                        {
                            <option value="@product.ProductID">@product.ProductName</option>
                        }
                    </select>
                </div>

                <div class="ccs-field">
                    <label for="adjustQuantity">Quantity to Adjust</label>
                    <input id="adjustQuantity" name="quantity" type="number" min="1" step="1"
                           class="form-control" placeholder="Enter number of units" required />
                </div>

                <div class="ccs-field">
                    <label for="adjustOperation">Operation</label>
                    <select id="adjustOperation" name="adjustmentType" class="form-select" required>
                        <option value="add">Add Stock</option>
                        <option value="remove">Remove Available Stock</option>
                    </select>
                </div>
            </div>

            <div class="ccs-auth-panel">
                <div class="ccs-section-heading">
                    <span class="ccs-eyebrow">EMPLOYEE AUTHORIZATION</span>
                    <h3>Verify Credentials</h3>
                    <p>Only authorized employees may change available quantities.</p>
                </div>
                <div class="ccs-form-grid">
                    <div class="ccs-field">
                        <label for="adjustUsername">Employee Username</label>
                        <input id="adjustUsername" name="username" type="text"
                               class="form-control" autocomplete="username" required />
                    </div>
                    <div class="ccs-field">
                        <label for="adjustPassword">Employee Password</label>
                        <input id="adjustPassword" name="password" type="password"
                               class="form-control" autocomplete="off" required />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg ccs-transfer-button">
                Confirm Stock Adjustment &rarr;
            </button>
        </form>
    </section>

    <section class="ccs-dashboard-section ccs-transfer-panel">

        <div class="ccs-section-heading">
            <span class="ccs-eyebrow">AUTHORIZED OPERATIONS</span>
            <h2>Transfer Inventory</h2>
            <p>
                Move available products between store locations.
                Employee credentials are required.
            </p>
        </div>

        <form asp-controller="Inventory"
              asp-action="MoveInventory"
              method="post">

            @Html.AntiForgeryToken()

            <div class="ccs-form-grid">

                <div class="ccs-field">

                    <label for="fromStoreID">From Store</label>

                    <select id="fromStoreID"
                            name="fromStoreID"
                            class="form-select"
                            required>

                        <option value="1" selected="@(selectedStoreID == 1)">
                            Houston
                        </option>

                        <option value="2" selected="@(selectedStoreID == 2)">
                            Dallas
                        </option>

                        <option value="3" selected="@(selectedStoreID == 3)">
                            San Antonio
                        </option>

                    </select>

                </div>

                <div class="ccs-field">

                    <label for="toStoreID">To Store</label>

                    <select id="toStoreID"
                            name="toStoreID"
                            class="form-select"
                            required>

                        <option value="" selected disabled>
                            Select Destination
                        </option>

                        <option value="1">Houston</option>
                        <option value="2">Dallas</option>
                        <option value="3">San Antonio</option>

                    </select>

                </div>

                <div class="ccs-field">

                    <label for="transferProductID">Product</label>

                    <select id="transferProductID"
                            name="productID"
                            class="form-select"
                            required>

                        @foreach (var product in products)
                        {
                            <option value="@product.ProductID">
                                @product.ProductName
                            </option>
                        }

                    </select>

                </div>

                <div class="ccs-field">

                    <label for="transferQuantity">Transfer Quantity</label>

                    <input id="transferQuantity"
                           type="number"
                           name="quantity"
                           min="1"
                           class="form-control"
                           placeholder="Enter quantity"
                           required />

                </div>

            </div>

            <div class="ccs-auth-panel">

                <div class="ccs-section-heading">
                    <span class="ccs-eyebrow">SECURE ACTION</span>
                    <h3>Employee Authorization</h3>
                    <p>
                        Enter your employee credentials
                        to authorize this transfer.
                    </p>
                </div>

                <div class="ccs-form-grid">

                    <div class="ccs-field">

                        <label for="transferUsername">
                            Employee Username
                        </label>

                        <input id="transferUsername"
                               type="text"
                               name="username"
                               class="form-control"
                               autocomplete="username"
                               required />

                    </div>

                    <div class="ccs-field">

                        <label for="transferPassword">
                            Employee Password
                        </label>

                        <input id="transferPassword"
                               type="password"
                               name="password"
                               class="form-control"
                               autocomplete="off"
                               required />

                    </div>

                </div>

            </div>

            <button type="submit"
                    class="btn btn-primary btn-lg ccs-transfer-button">
                Confirm Inventory Transfer &rarr;
            </button>

        </form>

    </section>

    <section class="ccs-dashboard-section ccs-transfer-panel">

        <div class="ccs-section-heading">
            <span class="ccs-eyebrow">EMPLOYEE STOCK CONTROL</span>
            <h2>Manage Stock Reservations</h2>
            <p>
                Reserve products for employee handling
                or return employee-held items to available stock.
            </p>
        </div>

        <form asp-controller="Inventory"
              asp-action="ReserveStock"
              method="post"
              id="reservationForm">

            @Html.AntiForgeryToken()

            <div class="ccs-form-grid">

                <div class="ccs-field">

                    <label for="reservationStoreID">Store</label>

                    <select id="reservationStoreID"
                            name="storeID"
                            class="form-select"
                            required>

                        <option value="1" selected="@(selectedStoreID == 1)">
                            Houston
                        </option>

                        <option value="2" selected="@(selectedStoreID == 2)">
                            Dallas
                        </option>

                        <option value="3" selected="@(selectedStoreID == 3)">
                            San Antonio
                        </option>

                    </select>

                </div>

                <div class="ccs-field">

                    <label for="reservationProductID">Product</label>

                    <select id="reservationProductID"
                            name="productID"
                            class="form-select"
                            required>

                        @foreach (var product in products)
                        {
                            <option value="@product.ProductID">
                                @product.ProductName
                            </option>
                        }

                    </select>

                </div>

                <div class="ccs-field">

                    <label for="reservationQuantity">Quantity</label>

                    <input id="reservationQuantity"
                           type="number"
                           name="quantity"
                           min="1"
                           class="form-control"
                           placeholder="Enter quantity"
                           required />

                </div>

            </div>

            <div class="ccs-auth-panel">

                <div class="ccs-section-heading">
                    <span class="ccs-eyebrow">EMPLOYEE AUTHORIZATION</span>
                    <h3>Verify Credentials</h3>
                    <p>
                        Authorization is required for both
                        reserving and returning stock.
                    </p>
                </div>

                <div class="ccs-form-grid">

                    <div class="ccs-field">

                        <label for="reservationUsername">
                            Employee Username
                        </label>

                        <input id="reservationUsername"
                               type="text"
                               name="username"
                               class="form-control"
                               autocomplete="username"
                               required />

                    </div>

                    <div class="ccs-field">

                        <label for="reservationPassword">
                            Employee Password
                        </label>

                        <input id="reservationPassword"
                               type="password"
                               name="password"
                               class="form-control"
                               autocomplete="off"
                               required />

                    </div>

                </div>

            </div>

            <div class="ccs-reservation-actions">

                <button type="submit"
                        class="btn btn-primary btn-lg">
                    Reserve Stock
                </button>

                <button type="submit"
                        formaction="@Url.Action("ReturnReservedStock", "Inventory")"
                        class="btn btn-secondary btn-lg">
                    Return to Shelf
                </button>

            </div>

        </form>

    </section>

</section>

@if (selectedStoreID != null)
{
    <script>
        async function refreshInventory() {
            try {
                const response = await fetch(
                    '@Url.Action("GetStock", "Inventory", new { storeID = selectedStoreID })',
                    { cache: "no-store" }
                );

                if (!response.ok) return;

                const inventory = await response.json();

                inventory.forEach(item => {

                    const available =
                        document.getElementById(
                            `quantity-${item.productID}`
                        );

                    const reserved =
                        document.getElementById(
                            `reserved-${item.productID}`
                        );

                    const employeeReserved =
                        document.getElementById(
                            `employee-reserved-${item.productID}`
                        );

                    const badge =
                        document.getElementById(
                            `stock-badge-${item.productID}`
                        );

                    if (available) {
                        available.textContent = item.quantity;
                    }

                    if (reserved) {
                        reserved.textContent = item.reservedQuantity;
                    }

                    if (employeeReserved) {
                        employeeReserved.textContent =
                            item.employeeReservedQuantity;
                    }

                    if (badge) {
                        badge.classList.toggle(
                            "is-out-of-stock",
                            item.quantity <= 0
                        );
                    }

                });

            } catch (error) {
                console.error("Inventory refresh failed:", error);
            }
        }

        refreshInventory();
        setInterval(refreshInventory, 10000);
    </script>
}
