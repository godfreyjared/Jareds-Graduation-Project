@model List<Jared_s_Graduation_Project.Product>
@using Jared_s_Graduation_Project

@{
    ViewData["Title"] = "Products";

    var inventory = (List<Inventory>)ViewBag.Inventory;

    int? selectedStoreID = ViewBag.StoreID == null
        ? null
        : (int)ViewBag.StoreID;

    bool cartHasItems = ViewBag.CartHasItems == true;

    string storeName = selectedStoreID switch
    {
        1 => "Houston",
        2 => "Dallas",
        3 => "San Antonio",
        _ => "No Store Selected"
    };
}

<h1>Continental Computing Solutions</h1>


@if (TempData["Message"] != null)
{
    bool isError = TempData["MessageType"]?.ToString() == "error";

    <p class="@(isError ? "text-danger" : "text-success") fw-bold">
        @TempData["Message"]
    </p>
}


@if (selectedStoreID == null)
{
    <h2>Select Your Store</h2>

    <p>
        Choose a location to view available products
        and begin shopping.
    </p>

    <form asp-controller="Cart"
          asp-action="SelectStore"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="storeID" class="form-label">
                Store Location:
            </label>

            <select name="storeID"
                    id="storeID"
                    class="form-select">

                <option value="1">Houston</option>
                <option value="2">Dallas</option>
                <option value="3">San Antonio</option>

            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Shop This Store
        </button>
    </form>
}
else
{
    <h2>Shopping at @storeName</h2>

    <p>
        All products added to your cart will be
        reserved from the @storeName location.
    </p>

    @if (!cartHasItems)
    {
        <form asp-controller="Cart"
              asp-action="SelectStore"
              method="post">

            @Html.AntiForgeryToken()

            <label for="storeID" class="form-label">
                Change Store:
            </label>

            <select name="storeID"
                    id="storeID"
                    class="form-select mb-2">

                <option value="1"
                        selected="@(selectedStoreID == 1)">
                    Houston
                </option>

                <option value="2"
                        selected="@(selectedStoreID == 2)">
                    Dallas
                </option>

                <option value="3"
                        selected="@(selectedStoreID == 3)">
                    San Antonio
                </option>

            </select>

            <button type="submit" class="btn btn-secondary">
                Change Store
            </button>
        </form>
    }
    else
    {
        <p>
            <strong>
                Complete checkout or empty your cart
                before changing stores.
            </strong>
        </p>
    }

    <hr />

    <a asp-controller="Products"
       asp-action="Create"
       class="btn btn-primary">
        Create New Product
    </a>

    <hr />

    @foreach (var product in Model)
    {
        var inventoryItem = inventory.FirstOrDefault(i =>
            i.StoreID == selectedStoreID.Value &&
            i.ProductID == product.ProductID);

        int availableQuantity = inventoryItem?.Quantity ?? 0;

        <div>
            <h2>@product.ProductName</h2>

            <p>Category: @product.ProductCategory</p>

            <p>Price: @product.ProductPrice.ToString("C")</p>

            <p>
                Available in @storeName:
                <span id="stock-@product.ProductID">
                    @availableQuantity
                </span>
            </p>

            <span id="cart-action-@product.ProductID">

                <a asp-controller="Cart"
                   asp-action="AddToCart"
                   asp-route-productID="@product.ProductID"
                   class="btn btn-success"
                   data-cart-button
                   hidden="@(availableQuantity <= 0)">
                    Add to Cart
                </a>

                <span class="text-danger"
                      data-out-of-stock
                      hidden="@(availableQuantity > 0)">
                    Out of Stock
                </span>

            </span>

            <a asp-controller="Products"
               asp-action="Edit"
               asp-route-id="@product.ProductID"
               class="btn btn-secondary">
                Edit Product
            </a>

            <a asp-controller="Products"
               asp-action="Delete"
               asp-route-id="@product.ProductID"
               class="btn btn-danger">
                Delete Product
            </a>
        </div>

        <hr />
    }

    <script>
        async function updateStock() {
            try {
                const response = await fetch(
                    '@Url.Action("GetStock", "Products", new { storeID = selectedStoreID })',
                    { cache: "no-store" }
                );

                if (!response.ok) return;

                const stock = await response.json();

                stock.forEach(item => {
                    const stockElement =
                        document.getElementById(
                            `stock-${item.productID}`
                        );

                    const actionContainer =
                        document.getElementById(
                            `cart-action-${item.productID}`
                        );

                    if (stockElement) {
                        stockElement.textContent = item.quantity;
                    }

                    if (actionContainer) {
                        const addButton =
                            actionContainer.querySelector(
                                '[data-cart-button]'
                            );

                        const outOfStock =
                            actionContainer.querySelector(
                                '[data-out-of-stock]'
                            );

                        const isAvailable = item.quantity > 0;

                        if (addButton) {
                            addButton.hidden = !isAvailable;
                        }

                        if (outOfStock) {
                            outOfStock.hidden = isAvailable;
                        }
                    }
                });

            } catch (error) {
                console.error(
                    "Unable to update stock:",
                    error
                );
            }
        }

        updateStock();
        setInterval(updateStock, 10000);
    </script>
}
