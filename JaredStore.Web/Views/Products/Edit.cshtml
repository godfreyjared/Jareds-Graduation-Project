@model Jared_s_Graduation_Project.Product

@{
    ViewData["Title"] = "Edit Product";
}

<section class="ccs-admin-page">

    <div class="ccs-page-heading">
        <span class="ccs-eyebrow">CONTINENTAL OPERATIONS</span>
        <h1>Edit Product</h1>
        <p>
            Update an existing component in the Continental
            Computing Solutions product catalog.
        </p>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="ccs-notice" role="alert">
            @ViewBag.Message
        </div>
    }

    <form asp-controller="Products"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="productID"
               value="@Model.ProductID" />

        <section class="ccs-admin-panel">

            <div class="ccs-admin-panel-heading">

                <span class="ccs-admin-step">01</span>

                <div>
                    <span class="ccs-eyebrow">PRODUCT MANAGEMENT</span>
                    <h2>Product Information</h2>
                    <p>
                        Modify the product details below.
                        Product ID: @Model.ProductID
                    </p>
                </div>

            </div>

            <div class="ccs-admin-fields">

                <div class="ccs-field ccs-admin-full-width">

                    <label for="productName">Product Name</label>

                    <input type="text"
                           id="productName"
                           name="productName"
                           value="@Model.ProductName"
                           class="form-control"
                           maxlength="150"
                           required />

                </div>

                <div class="ccs-field">

                    <label for="productCategory">Category</label>

                    <input type="text"
                           id="productCategory"
                           name="productCategory"
                           value="@Model.ProductCategory"
                           class="form-control"
                           required />

                </div>

                <div class="ccs-field">

                    <label for="productPrice">Unit Price ($)</label>

                    <input type="number"
                           id="productPrice"
                           name="productPrice"
                           value="@Model.ProductPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                           min="0.01"
                           step="0.01"
                           class="form-control"
                           required />

                </div>

            </div>

        </section>

        <section class="ccs-admin-panel">

            <div class="ccs-admin-panel-heading">

                <span class="ccs-admin-step">02</span>

                <div>
                    <span class="ccs-eyebrow">AUTHORIZED PERSONNEL</span>
                    <h2>Employee Authorization</h2>
                    <p>
                        Verify your employee credentials
                        to save these changes.
                    </p>
                </div>

            </div>

            <div class="ccs-admin-fields">

                <div class="ccs-field">

                    <label for="username">Employee Username</label>

                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           autocomplete="username"
                           required />

                </div>

                <div class="ccs-field">

                    <label for="password">Employee Password</label>

                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           autocomplete="off"
                           required />

                </div>

            </div>

        </section>

        <div class="ccs-admin-actions">

            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-secondary btn-lg">
                &larr; Back to Products
            </a>

            <button type="submit"
                    class="btn btn-primary btn-lg">
                Save Changes &rarr;
            </button>

        </div>

    </form>

</section>
