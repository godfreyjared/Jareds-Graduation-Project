@model Jared_s_Graduation_Project.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>

@if (ViewBag.Message != null)
{
    <p style="color: red; font-weight: bold;">
        @ViewBag.Message
    </p>
}

<p>Are you sure you want to delete this product?</p>

<h3>@Model.ProductName</h3>

<p>Category: @Model.ProductCategory</p>
<p>Price: @Model.ProductPrice.ToString("C")</p>

<p>
    This will also remove the product's inventory records
    from Houston, Dallas, and San Antonio.
</p>

<form asp-controller="Products"
      asp-action="Delete"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="productID"
           value="@Model.ProductID" />

    <hr />

    <h3>Employee Authorization</h3>

    <div>
        <label>Employee Username:</label>
        <input type="text"
               name="username"
               autocomplete="username"
               required />
    </div>

    <div>
        <label>Employee Password:</label>
        <input type="password"
               name="password"
               autocomplete="off"
               required />
    </div>

    <br />

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>
</form>

<p>
    <a asp-controller="Products"
       asp-action="Index">
        Cancel
    </a>
</p>
